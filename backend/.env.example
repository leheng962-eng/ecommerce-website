# Copy this file to ".env" and change the values.
# NEVER commit the real .env file to Git.
PORT=5000
NODE_ENV=development

# Local MongoDB. With Docker Compose this is replaced automatically.
MONGO_URI=mongodb://127.0.0.1:27017/shopnest

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Used by seed.js to create the first admin account
ADMIN_EMAIL=admin@shopnest.com
ADMIN_PASSWORD=Admin12345
